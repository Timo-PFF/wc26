{
  "name": "wc26-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + D1 backend for the World Cup prediction pool (replaces the Apps Script backend).",
  "scripts": {
    "dev": "wrangler dev --config wrangler.v2.toml",
    "db:init:local": "wrangler d1 execute wc26 --local --config wrangler.v2.toml --file=schema_v2.sql",
    "db:seed:local": "wrangler d1 execute wc26 --local --config wrangler.v2.toml --file=seed/seed_v2.sql",
    "db:init:remote": "wrangler d1 execute wc26 --remote --file=schema_v2.sql",
    "db:seed:remote": "wrangler d1 execute wc26 --remote --file=seed/seed_v2.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
